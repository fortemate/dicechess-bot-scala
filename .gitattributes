# Default behavior: enforce LF line endings for all text files automatically
* text=auto eol=lf

# Scala source files
*.scala       text eol=lf
*.sbt         text eol=lf

# Configuration and data files
*.json        text eol=lf
*.toml        text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.funcignore   text eol=lf

# Documentation files
*.md          text eol=lf
*.txt         text eol=lf
